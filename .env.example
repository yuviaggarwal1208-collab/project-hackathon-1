# Copy this file to `.env` and fill in YOUR OWN Supabase project values.
# `.env` is git-ignored; never commit real credentials.
#
# Only the project URL and the PUBLISHABLE (anon) key belong in the browser.
# Anything prefixed with VITE_ is compiled into the public JavaScript bundle.
# NEVER put a service_role / secret key here (or anywhere in this app).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional: server-side connection string used only by the database test suites
# (`npm run test:db`, `npm run test:race`). Not read by the browser app.
# Local Supabase stack example:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
